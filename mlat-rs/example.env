# Copy to .env and edit. Every value below is the default unless noted.

# ---- container -----------------------------------------------------------
MLAT_CONTAINER_NAME=mlat-server
# Host directory for the state files (sync.json, clients.json, aircraft.json)
# and positions.csv. Must be writable by uid 10001 (chown 10001 ./work).
MLAT_WORK_DIR=./work
# CPU cores the container may use; the server spreads over all of them.
MLAT_CPUS=4

# ---- published ports (host side) -------------------------------------------
MLAT_CLIENT_PORT=31090
MLAT_FILTERED_PORT=31003
MLAT_UNFILTERED_PORT=31004

# ---- what the server listens on (inside the container) ---------------------
# Receiver connections: [host:]tcp_port[:udp_port], space separated.
# 31090 is TCP only, as the Python server is run today. Add a UDP port
# (31090:31090) to let receivers that offer the UDP transport use it.
MLAT_CLIENT_LISTEN=31090
# Basestation output: Kalman filtered (what readsb reads) and unfiltered.
MLAT_FILTERED_LISTEN=31003
MLAT_UNFILTERED_LISTEN=31004
# Connect out to a Basestation consumer instead (host:port, space separated).
MLAT_FILTERED_CONNECT=
MLAT_UNFILTERED_CONNECT=
# Rotating CSV of results (1 MB x 10 files). Path inside the container.
MLAT_WRITE_CSV=/run/mlat-server/positions.csv

# ---- tuning ----------------------------------------------------------------
# Threads for the position engine. 2-4 is plenty on a 4-vCPU VPS; leave empty
# for the default (1).
MLAT_ENGINE_THREADS=
# Threads for client connections. Empty = min(cores, 4).
MLAT_IO_THREADS=
# Seconds between status log lines (multiple of 15), -1 to disable.
MLAT_STATUS_INTERVAL=15
# Several servers sharing the aircraft between them: I/N (empty = single server).
MLAT_PARTITION=

# ---- identity --------------------------------------------------------------
# Shown to receivers.
MLAT_MOTD=
# AGPL: where the source of THIS server can be obtained. Set to your fork.
MLAT_SOURCE_URL=https://github.com/myromeo/mlat-server-rs

# ---- debugging -------------------------------------------------------------
# JSON-lines dump of every solver input (large!). Path inside the container.
MLAT_DUMP_PSEUDORANGE=
